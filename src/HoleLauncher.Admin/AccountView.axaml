<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:input="using:Avalonia.Input"
             xmlns:local="using:HoleLauncher.Admin"
             x:Class="HoleLauncher.Admin.AccountView"
             Background="#10141C">
  <UserControl.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.navigation.selected">
      <Setter Property="Background" Value="#243954" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid x:Name="Dashboard" IsVisible="False" ColumnDefinitions="190,*" RowDefinitions="Auto,*">
      <Border x:Name="Navigation" Grid.RowSpan="2" Background="#171E29" Padding="12,18">
        <StackPanel Spacing="8">
          <TextBlock Text="{local:Loc brand.title}" FontFamily="{StaticResource SnProSemiBold}" FontSize="19" Margin="8,0,0,12" />
          <WrapPanel x:Name="NavigationButtons" Orientation="Vertical">
            <Button x:Name="ProfileNav" Classes="navigation selected" Content="{local:Loc nav.profile}" Click="OnProfileNav" />
            <Button x:Name="ServerNav" Classes="navigation" Content="{local:Loc nav.server}" Click="OnServerNav" />
            <Button x:Name="UsersNav" Classes="navigation" Content="{local:Loc nav.users}" Click="OnUsersNav" />
            <Button x:Name="StorageNav" Classes="navigation" Content="{local:Loc nav.storage}" Click="OnStorageNav" IsVisible="False" />
            <Button x:Name="OfferNav" Classes="navigation" Content="{local:Loc nav.offer}" Click="OnOfferNav" IsVisible="False" />
            <Button x:Name="RepositoryNav" Classes="navigation" Content="{local:Loc nav.repository}" Click="OnRepositoryNav" IsVisible="False" />
            <Button x:Name="LauncherNav" Classes="navigation" Content="{local:Loc launcher.title}" Click="OnLauncherNav" IsVisible="False" />
            <Button x:Name="LogoutButton" Classes="navigation" Content="{local:Loc nav.logout}" Click="OnLogout" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="DashboardContent" Grid.Column="1" Grid.RowSpan="2">
        <StackPanel Margin="24" MaxWidth="1050" HorizontalAlignment="Stretch" Spacing="18">
          <TextBlock x:Name="DashboardError" IsVisible="{CompiledBinding #DashboardError.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="AccountTitle" FontSize="28" FontFamily="{StaticResource SnProSemiBold}" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1" x:Name="LanguagePicker" VerticalAlignment="Center"
                      AutomationProperties.Name="{local:Loc language.selector}" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="{local:Loc language.ru}" />
              <ComboBoxItem Content="{local:Loc language.en}" />
            </ComboBox>
          </Grid>
          <StackPanel x:Name="ProfileContent" Spacing="16">
            <WrapPanel Orientation="Horizontal">
              <Border Background="#1A2230" Width="280" Height="410" CornerRadius="12" ClipToBounds="True" Margin="0,0,16,16">
                <Grid>
                  <local:SkinPreview x:Name="PlayerPreview" AutomationProperties.Name="{local:Loc game.preview}" />
                  <TextBlock x:Name="PreviewError" IsVisible="False" Text="{local:Loc game.preview_error}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <StackPanel Width="280" Spacing="10">
              <Border x:Name="GameProfilePanel" Padding="18" Background="#1A2230" CornerRadius="12" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <TextBlock Text="{local:Loc game.title}" FontSize="20" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="GameNameText" VerticalAlignment="Center" FontSize="18" TextWrapping="Wrap" />
                    <Button Grid.Column="1" x:Name="GameNameGear" ToolTip.Tip="{local:Loc game.name_history}" AutomationProperties.Name="{local:Loc game.name_history}" Click="OnToggleGameName">
                      <PathIcon Width="17" Height="17" Data="M10,2 L14,2 L15,5 L18,6 L21,5 L23,9 L21,11 L21,13 L23,15 L21,19 L18,18 L15,19 L14,22 L10,22 L9,19 L6,18 L3,19 L1,15 L3,13 L3,11 L1,9 L3,5 L6,6 L9,5 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z" />
                    </Button>
                  </Grid>
                  <StackPanel x:Name="GameNameEditor" IsVisible="False" Spacing="8">
                    <StackPanel x:Name="GameRenameFields" Spacing="8">
                      <TextBox x:Name="GameNameInput" Watermark="{local:Loc game.name}" MaxLength="16" />
                      <Button Content="{local:Loc game.save_name}" Click="OnSaveGameName" Classes="accent" />
                    </StackPanel>
                    <TextBlock Text="{local:Loc game.recent_names}" Foreground="#B8C5D8" />
                    <TextBlock x:Name="GameNameHistoryText" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel x:Name="SkinModelEditor" Spacing="7">
                    <ToggleSwitch x:Name="SlimSkinSwitch" OffContent="{local:Loc skin.classic}" OnContent="{local:Loc skin.slim}"
                                  AutomationProperties.Name="{local:Loc skin.model}" IsCheckedChanged="OnSkinModelSelected" />
                  </StackPanel>
                  <WrapPanel>
                    <Button x:Name="UploadSkinButton" Content="{local:Loc game.upload_skin}" Click="OnUploadSkin" Margin="0,0,8,0" />
                    <Button x:Name="RemoveSkinButton" Content="{local:Loc game.remove_skin}" Click="OnRemoveSkin" IsVisible="False" />
                  </WrapPanel>
                  <WrapPanel>
                    <Button x:Name="UploadCapeButton" Content="{local:Loc game.upload_cape}" Click="OnUploadCape" Margin="0,0,8,0" />
                    <Button x:Name="RemoveCapeButton" Content="{local:Loc game.remove_cape}" Click="OnRemoveCape" IsVisible="False" />
                  </WrapPanel>
                  <Button Content="{local:Loc account.settings}" Click="OnTogglePassword" />
                </StackPanel>
              </Border>
                <StackPanel x:Name="GameNotices" Spacing="8" />
              </StackPanel>
            </WrapPanel>
            <StackPanel x:Name="AccountOptions" IsVisible="False" Spacing="12">
      <Border x:Name="PasswordPanel" Padding="18" MaxWidth="600" HorizontalAlignment="Left" Background="#1A2230" CornerRadius="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{local:Loc account.change_password}" FontSize="16" />
          <local:PasswordField x:Name="NewPasswordInput" Watermark="{local:Loc account.new_password}" />
          <Button x:Name="ChangePasswordButton" Content="{local:Loc account.change_password}" Click="OnChangePassword" />
          <TextBlock x:Name="PasswordMessage" TextWrapping="Wrap"
                     IsVisible="{CompiledBinding #PasswordMessage.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
              <Border x:Name="PermissionsPanel" Padding="18" Background="#1A2230" CornerRadius="12" MaxWidth="600" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                  <TextBlock Text="{local:Loc account.permissions}" FontSize="16" />
                  <TextBlock x:Name="PermissionsText" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
      <Border x:Name="UserManagementPanel" IsVisible="False" Padding="24" Background="#1A2230" CornerRadius="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{local:Loc users.permissions}" FontSize="16" />
          <ComboBox x:Name="UserPicker" PlaceholderText="{local:Loc users.select}"
                    HorizontalAlignment="Stretch" SelectionChanged="OnUserSelected" />
          <StackPanel x:Name="UserFlagsPanel" IsVisible="False" Spacing="4">
            <StackPanel x:Name="PermissionFlags" Spacing="4" />
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="SavePermissionsButton" Content="{local:Loc common.save}" Click="OnSavePermissions" Margin="0,0,8,0" />
              <Button x:Name="ToggleSuppressionButton" Click="OnToggleSuppression" />
            </WrapPanel>
          </StackPanel>
          <TextBlock x:Name="UserManagementMessage" TextWrapping="Wrap"
                     IsVisible="{CompiledBinding #UserManagementMessage.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
      <Border x:Name="ServicesPanel" IsVisible="False" Padding="24" Background="#1A2230" CornerRadius="12">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{local:Loc server.title}" FontSize="16" VerticalAlignment="Center" />
            <Button x:Name="RefreshStatusButton" Grid.Column="1" Content="{local:Loc common.refresh}" Click="OnRefreshStatus" />
          </Grid>
          <TextBlock x:Name="ServicesMessage" TextWrapping="Wrap"
                     IsVisible="{CompiledBinding #ServicesMessage.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel x:Name="ServiceRows" Spacing="8" />
        </StackPanel>
      </Border>
          <StackPanel x:Name="RepositoryPanel" IsVisible="False" Spacing="12">
            <TextBlock Text="{local:Loc nav.repository}" FontSize="22" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{local:Loc repository.versions}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{local:Loc repository.new}" Click="OnNewRepositoryBuild" />
            </Grid>
            <ScrollViewer MaxHeight="250" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="RepositoryVersions" Spacing="6" />
            </ScrollViewer>
            <TextBox x:Name="RepositoryName" Watermark="{local:Loc repository.name}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <ComboBox x:Name="RepositoryMinecraft" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc repository.minecraft}"
                        AutomationProperties.Name="{local:Loc repository.minecraft}" SelectionChanged="OnRepositoryMinecraftChanged" />
              <ComboBox Grid.Column="1" x:Name="RepositoryLoader" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc repository.loader}"
                        AutomationProperties.Name="{local:Loc repository.loader}" SelectionChanged="OnRepositoryLoaderChanged" />
              <ComboBox Grid.Column="2" x:Name="RepositoryLoaderVersion" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc repository.loader_version}"
                        AutomationProperties.Name="{local:Loc repository.loader_version}" />
            </Grid>
            <Button Content="{local:Loc repository.build}" Click="OnBuildRepositoryVersion" />
            <TextBlock x:Name="RepositoryMessage" TextWrapping="Wrap" />
            <TextBox x:Name="RepositoryBuildProgressText" IsVisible="False" IsReadOnly="True" MaxHeight="180" TextWrapping="Wrap" />
            <Button x:Name="RepositoryReportButton" IsVisible="False" Content="{local:Loc repository.build_report}" Click="OnShowRepositoryReport" />
            <TextBox x:Name="RepositoryBuildReport" IsVisible="False" IsReadOnly="True" MaxHeight="220" TextWrapping="Wrap" />
            <TextBlock x:Name="RepositoryUploadMessage" TextWrapping="Wrap" />
            <ProgressBar x:Name="RepositoryUploadProgress" IsVisible="False" Maximum="100" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="RepositoryFolder" Watermark="{local:Loc repository.destination}" />
              <ComboBox Grid.Column="1" x:Name="RepositoryTypePicker" AutomationProperties.Name="{local:Loc repository.type}" />
            </Grid>
            <TabControl>
              <TabItem x:Name="RepositoryBuildFilesTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch x:Name="RepositoryTreeToggle" OnContent="" OffContent="" VerticalAlignment="Center"
                                  AutomationProperties.Name="{local:Loc repository.tree}" ToolTip.Tip="{local:Loc repository.tree}"
                                  IsCheckedChanged="OnRepositoryTreeToggled" />
                    <TextBlock Text="{local:Loc repository.files}" VerticalAlignment="Center" />
                  </StackPanel>
                </TabItem.Header>
                <StackPanel Spacing="8">
                  <Grid x:Name="RepositoryFindBar" IsVisible="False" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="RepositoryFindText" Watermark="{local:Loc repository.find_files}"
                             TextChanged="OnRepositoryFindChanged" KeyDown="OnRepositoryFindKeyDown" />
                    <TextBlock Grid.Column="1" x:Name="RepositoryFindCount" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="↑" ToolTip.Tip="{local:Loc repository.find_previous}" Click="OnPreviousRepositoryMatch" />
                    <Button Grid.Column="3" Content="↓" ToolTip.Tip="{local:Loc repository.find_next}" Click="OnNextRepositoryMatch" />
                    <Button Grid.Column="4" Content="×" ToolTip.Tip="{local:Loc repository.find_close}" Click="OnCloseRepositoryFind" />
                  </Grid>
                  <ListBox x:Name="RepositoryFiles" MaxHeight="560" Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                  <StackPanel x:Name="RepositoryTreePanel" IsVisible="False" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox x:Name="RepositoryNewFolder" Watermark="{local:Loc repository.folder_name}" />
                      <Button Grid.Column="1" Content="{local:Loc repository.folder_add}" Click="OnAddRepositoryTreeFolder" />
                      <Button Grid.Column="2" x:Name="RepositoryRemoveFolder" IsEnabled="False"
                              Content="{local:Loc repository.folder_remove}" Click="OnRemoveRepositoryTreeFolder" />
                    </Grid>
                    <TreeView x:Name="RepositoryFileTree" MaxHeight="430" SelectionChanged="OnRepositoryTreeSelected"
                              PointerCaptureLost="OnRepositoryTreePointerCaptureLost" />
                    <ContentControl x:Name="RepositoryTreeDetails" />
                  </StackPanel>
                </StackPanel>
              </TabItem>
              <TabItem Header="{local:Loc repository.modrinth}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="RepositoryModQuery" Watermark="{local:Loc repository.search}" KeyDown="OnRepositorySearchKeyDown" />
                    <Button Grid.Column="1" Content="{local:Loc repository.search}" Click="OnSearchRepositoryMods" />
                  </Grid>

                  <WrapPanel>
                    <Button x:Name="RepositoryMoreMods" IsEnabled="False" Content="{local:Loc repository.more}" Click="OnMoreRepositoryMods" Margin="0,0,8,0" />
                    <Button Content="{local:Loc repository.add_selected}" Click="OnAddSelectedMods" />
                  </WrapPanel>
                  <StackPanel x:Name="RepositorySelectedMods" Spacing="8" />
                  <StackPanel x:Name="RepositoryModHits" Spacing="8" />
                </StackPanel>
              </TabItem>
              <TabItem Header="{local:Loc repository.backend}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="#53647A" Background="#1A2230"
                            input:DragDrop.AllowDrop="True" input:DragDrop.DragOver="OnRepositoryDragOver" input:DragDrop.Drop="OnRepositoryDropFile">
                      <StackPanel Spacing="6">
                        <Button Content="{local:Loc repository.choose_file}" Click="OnChooseRepositoryFile" />
                        <TextBlock x:Name="RepositoryUploadedFileName" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="#53647A" Background="#1A2230"
                            input:DragDrop.AllowDrop="True" input:DragDrop.DragOver="OnRepositoryDragOver" input:DragDrop.Drop="OnRepositoryDropIcon">
                      <StackPanel Spacing="6">
                        <Button Content="{local:Loc repository.choose_icon}" Click="OnChooseRepositoryIcon" />
                        <TextBlock x:Name="RepositoryUploadedIconName" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBox x:Name="RepositoryStorageTitle" Watermark="{local:Loc repository.title}" />
                  <TextBox x:Name="RepositoryStorageDescription" Watermark="{local:Loc repository.description}" />
                  <Button Content="{local:Loc repository.add}" Click="OnAddRepositoryStorage" />
                </StackPanel>
              </TabItem>
              <TabItem Header="{local:Loc repository.batch}">
                <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="#53647A" Background="#1A2230"
                        input:DragDrop.AllowDrop="True" input:DragDrop.DragOver="OnRepositoryDragOver" input:DragDrop.Drop="OnRepositoryDropZip">
                  <Button Content="{local:Loc repository.choose_zip}" Click="OnChooseRepositoryZip" />
                </Border>
              </TabItem>
              <TabItem Header="{local:Loc offer.users}">
                <StackPanel Spacing="8">
                  <Button Content="{local:Loc offer.refresh}" Click="OnRefreshOffers" />
                  <StackPanel x:Name="RepositoryOffers" Spacing="8" />
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
          <StackPanel x:Name="OfferPanel" IsVisible="False" Spacing="10">
            <TextBlock Text="{local:Loc nav.offer}" FontSize="22" />
            <ComboBox x:Name="OfferBuild" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc offer.target}"
                      AutomationProperties.Name="{local:Loc offer.target}" SelectionChanged="OnOfferBuildChanged" />
            <TextBox x:Name="OfferDescription" Watermark="{local:Loc offer.description}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" />
            <TabControl>
              <TabItem Header="{local:Loc repository.modrinth}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OfferQuery" Watermark="{local:Loc repository.search}" KeyDown="OnOfferSearchKeyDown" />
                    <Button Grid.Column="1" Content="{local:Loc repository.search}" Click="OnOfferSearch" />
                  </Grid>
                  <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OfferHits" Spacing="6" />
                  </ScrollViewer>
                </StackPanel>
              </TabItem>
              <TabItem Header="{local:Loc offer.local_files}">
                <Button Content="{local:Loc repository.choose_file}" Click="OnOfferUpload" />
              </TabItem>
            </TabControl>
            <TextBlock Text="{local:Loc offer.selected}" />
            <StackPanel x:Name="OfferSelected" Spacing="6" />
            <Button Content="{local:Loc offer.submit}" Click="OnSubmitOffer" />
            <TextBlock x:Name="OfferMessage" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="LauncherPanel" IsVisible="False" Spacing="10">
            <TextBlock Text="{local:Loc launcher.title}" FontSize="22" />
            <TextBox x:Name="LauncherRepository" Watermark="{local:Loc launcher.repository}" />
            <Button Content="{local:Loc launcher.import}" Click="OnImportLauncher" />
            <TextBlock x:Name="LauncherMessage" TextWrapping="Wrap" />
            <WrapPanel x:Name="LauncherDownloads" IsVisible="False">
              <HyperlinkButton x:Name="LauncherWindowsDownload" Content="{local:Loc launcher.windows}" Margin="0,0,8,0" />
              <HyperlinkButton x:Name="LauncherLinuxDownload" Content="{local:Loc launcher.linux}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel x:Name="StoragePanel" IsVisible="False" Spacing="16">
            <Border x:Name="StorageFilesPanel" Padding="20" Background="#1A2230" CornerRadius="12">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{local:Loc storage.files}" FontSize="20" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{local:Loc common.refresh}" Click="OnRefreshStorage" />
                </Grid>
                <TreeView x:Name="StorageTree" MaxHeight="440" SelectionChanged="OnStorageSelectionChanged">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="local:StorageTreeNode" ItemsSource="{CompiledBinding Children}">
                      <TextBlock Text="{CompiledBinding Name}" TextWrapping="Wrap" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel x:Name="StorageSelectedPanel" IsVisible="False" Spacing="8">
                  <TextBlock x:Name="StorageFileDetails" TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <HyperlinkButton x:Name="StorageDownload" Content="{local:Loc storage.download}" Margin="0,0,8,0" />
                    <Button x:Name="StorageDeleteButton" Content="{local:Loc storage.delete}" Click="OnDeleteStorageFile" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="StorageMessage" TextWrapping="Wrap"
                           IsVisible="{CompiledBinding #StorageMessage.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
            <Border x:Name="StorageCleanupPanel" Padding="20" Background="#1A2230" CornerRadius="12">
              <StackPanel Spacing="10">
                <TextBlock Text="{local:Loc storage.history}" FontSize="20" />
                <ComboBox x:Name="HistoryOwnerPicker" HorizontalAlignment="Stretch"
                          PlaceholderText="{local:Loc storage.select_scope}" SelectionChanged="OnHistoryOwnerChanged" />
                <Button x:Name="HistoryCleanupButton" Content="{local:Loc storage.clean}" Click="OnCleanHistory" IsEnabled="False" />
                <TextBlock x:Name="HistoryCleanupMessage" TextWrapping="Wrap"
                           IsVisible="{CompiledBinding #HistoryCleanupMessage.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Canvas x:Name="RepositoryDragOverlay" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="RepositoryDragPreview" IsVisible="False" Background="#263950"
              BorderBrush="#5A8AC0" BorderThickness="1" CornerRadius="6" Padding="8,5" MaxWidth="220" />
    </Canvas>
  </Grid>
</UserControl>
