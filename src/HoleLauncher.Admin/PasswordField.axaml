<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HoleLauncher.Admin"
             x:Class="HoleLauncher.Admin.PasswordField">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
    <local:ToggleablePasswordTextBox x:Name="PasswordInput" PasswordChar="•" />
    <ToggleButton x:Name="PasswordVisibility" Grid.Column="1" Click="OnPasswordVisibilityChanged"
                  Width="40" HorizontalContentAlignment="Center"
                  AutomationProperties.Name="{local:Loc account.toggle_password}"
                  ToolTip.Tip="{local:Loc account.toggle_password}">
      <ToggleButton.Styles>
        <Style Selector="ToggleButton:checked PathIcon">
          <Setter Property="Data" Value="M3 2 L19 18 L18 19 L2 3 Z M7 4 C11 2 16 4 20 10 C19 12 17 14 16 15 L14.5 13.5 C16 12.5 17 11 18 10 C15.5 6.5 12 4.5 8.5 5.5 Z M5 7 L6.5 8.5 C5.5 9 4 10 3 11 C5.5 14 9 16 12.5 15 L14 16.5 C9 18 4 15 1 11 C2 9.5 3.5 8 5 7 Z" />
        </Style>
      </ToggleButton.Styles>
      <PathIcon Width="18" Height="18"
                Data="F0 M0 10 C3 5 6 3 10 3 C14 3 17 5 20 10 C17 15 14 17 10 17 C6 17 3 15 0 10 Z M2.5 10 C5 6.5 7 5 10 5 C13 5 15 6.5 17.5 10 C15 13.5 13 15 10 15 C7 15 5 13.5 2.5 10 Z M10 7 A3 3 0 1 1 9.99 7 Z" />
    </ToggleButton>
  </Grid>
</UserControl>
